# OpenAI-compatible endpoint. Ollama, vLLM, LM Studio, or a cloud provider all work.
# Must match `ollama list` exactly. Example on this Mac: Qwen2.5-Coder:14b
# The web UI and `--base-url` can override this per task.
LBW_MODEL_NAME=Qwen2.5-Coder:14b
LBW_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LBW_MODEL_API_KEY=ollama

# KiwiFS knowledge base. LBW searches it instead of stuffing notes into the
# prompt. Default matches a server on this machine. Set empty to disable.
# From Docker Desktop use http://host.docker.internal:3333.
LBW_KIWIFS_URL=http://127.0.0.1:3333
# LBW_KIWIFS_API_KEY=
# LBW_KIWIFS_PREFIX=projects/my-app/

# Docker: host folder mounted at /workspaces (cloned repos and .lbw/runs persist here).
# LBW_WORKSPACE=./workspaces
# LBW_UI_PORT=8080

# Tokens this machine can hold. Leave unset to use the server's reported window.
# Set this when a local model advertises more context than the GPU can load.
# LBW_CONTEXT_WINDOW=8192

# Loop behavior
LBW_MAX_ITERATIONS=40
LBW_AUTO_COMMIT=true
LBW_REQUIRE_TESTS=true
LBW_PUBLISH=false
LBW_WATCH_INTERVAL_SECONDS=300
LBW_COMMAND_TIMEOUT_SECONDS=180
LBW_LOG_LEVEL=INFO

# Optional. Falls back to the host git config when unset.
# LBW_GIT_AUTHOR_NAME=agent-lbw
# LBW_GIT_AUTHOR_EMAIL=lbw@localhost
