# OpenAI-compatible endpoint. Ollama, vLLM, LM Studio, or a cloud provider all work.
# Must match `ollama list` exactly. Example on this Mac: Qwen2.5-Coder:14b
# The web UI and `--base-url` can override this per task.
LOCO_MODEL_NAME=Qwen2.5-Coder:14b
LOCO_MODEL_BASE_URL=http://127.0.0.1:11434/v1
LOCO_MODEL_API_KEY=ollama

# KiwiFS knowledge base. Loco searches it instead of stuffing notes into the
# prompt. Default matches a server on this machine. Set empty to disable.
# From Docker Desktop use http://host.docker.internal:3333.
LOCO_KIWIFS_URL=http://127.0.0.1:3333
# LOCO_KIWIFS_API_KEY=
# LOCO_KIWIFS_PREFIX=projects/my-app/

# Docker: host folder mounted at /workspaces (cloned repos and .loco/runs persist here).
# LOCO_WORKSPACE=./workspaces
# LOCO_UI_PORT=8080

# Loop behavior
LOCO_MAX_ITERATIONS=40
LOCO_AUTO_COMMIT=true
LOCO_REQUIRE_TESTS=true
LOCO_PUBLISH=false
LOCO_WATCH_INTERVAL_SECONDS=300
LOCO_COMMAND_TIMEOUT_SECONDS=180
LOCO_LOG_LEVEL=INFO

# Optional. Falls back to the host git config when unset.
# LOCO_GIT_AUTHOR_NAME=agent-loco
# LOCO_GIT_AUTHOR_EMAIL=loco@localhost
