# Base image for agent-loco sandbox execution
FROM python:3.12-slim

# Set non-root user with UID/GID 1000
RUN groupadd -r -g 1000 appgroup && \
    useradd -r -u 1000 -g appgroup appuser

# Create workspace directory
WORKDIR /workspace

# Create required directories for security
RUN mkdir -p /tmp /var/tmp /dev/shm

# Set ownership to non-root user
RUN chown -R appuser:appgroup /workspace /tmp /var/tmp /dev/shm

# Switch to non-root user
USER appuser

# Environment variables
ENV PYTHONPATH=/workspace
ENV PATH=/workspace/.local/bin:$PATH

# Install bash for command execution
RUN apt-get update && \
    apt-get install -y bash && \
    rm -rf /var/lib/apt/lists/*

# Default command (should be overridden by container runs)
CMD ["/bin/bash"]